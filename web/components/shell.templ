package components

import (
	"github.com/Onellan/tockrplatform/internal/domain"
)

templ Brand() {
	<a class="pf-brand" href="/" aria-label="Tockr Platform launcher">
		<span class="pf-brand-mark" aria-hidden="true">T</span>
		<span><strong>Tockr Platform</strong><small>Shared access foundation</small></span>
	</a>
}

templ Sidebar(user domain.User, csrfToken, activePath string) {
	<aside class="pf-sidebar" aria-label="Platform navigation">
		<div class="pf-sidebar-head">@Brand()</div>
		<nav class="pf-nav" aria-label="Primary">
			<p class="pf-nav-label">Operate</p>
			<a class={ navClass(activePath, "/") } href="/">Launcher</a>
			<a class={ navClass(activePath, "/organisations") } href="/organisations">Organisations</a>
			<a class={ navClass(activePath, "/admin") } href="/admin">Administration</a>
			<p class="pf-nav-label">Identity</p>
			<a class={ navClass(activePath, "/account") } href="/account">Account security</a>
		</nav>
		<div class="pf-sidebar-foot">
			<p>Platform owns shared identity, tenancy and product access. Product roles remain with CTRL and IMS.</p>
			<form method="post" action="/logout">
				<input type="hidden" name="csrf" value={ csrfToken } />
				<button class="pf-nav-action" type="submit">Sign out</button>
			</form>
		</div>
	</aside>
}

templ AccountMenu(user domain.User, csrfToken string) {
	<details class="pf-account-menu">
		<summary><span class="pf-avatar" aria-hidden="true">{ userInitial(user.DisplayName) }</span><span>{ user.DisplayName }</span></summary>
		<div class="pf-account-menu-items">
			<a href="/account">Account security</a>
			<form method="post" action="/logout">
				<input type="hidden" name="csrf" value={ csrfToken } />
				<button type="submit">Sign out</button>
			</form>
		</div>
	</details>
}

templ ContextHeader(title string, organisationName, workspaceName string) {
	<header class="pf-topbar">
		<div>
			<p class="pf-kicker">Platform</p>
			<h1>{ title }</h1>
		</div>
		<div class="pf-context-summary" aria-label="Current context">
			if organisationName != "" {
				<span>{ organisationName }</span>
			}
			if workspaceName != "" {
				<span aria-hidden="true">/</span><span>{ workspaceName }</span>
			}
		</div>
	</header>
}

func navClass(activePath, path string) string {
	if activePath == path || (path != "/" && len(activePath) > len(path) && activePath[:len(path)] == path) {
		return "pf-nav-link pf-nav-link-active"
	}
	return "pf-nav-link"
}

func userInitial(displayName string) string {
	for _, value := range displayName {
		return string(value)
	}
	return "U"
}
