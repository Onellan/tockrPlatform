package pages

import (
	"github.com/Onellan/tockrplatform/web/components"
	"github.com/Onellan/tockrplatform/web/layouts"
	"github.com/Onellan/tockrplatform/web/primitives"
)

templ adminNavigation(items []AdminNavItem) {
	<nav class="pf-admin-tabs" aria-label="Administration sections">
		for _, item := range items {
			<a class={ "pf-admin-tab", templ.KV("pf-admin-tab-active", item.Active) } href={ templ.SafeURL(item.Href) }>{ item.Label }</a>
		}
	</nav>
}

templ OrganisationAdmin(props OrganisationAdminProps) {
	@layouts.App("Organisation administration", props.User, props.CSRF, "/organisations") {
		@components.ContextHeader("Organisation administration", props.OrganisationName, props.Role)
		@adminNavigation(props.Navigation)
		if props.Flash != "" {
			<p class="pf-status pf-status-success" role="status">{ props.Flash }</p>
		}
		if props.Section == "general" {
			<section class="pf-section" aria-labelledby="general-heading">
				<div class="pf-section-heading"><div><p class="pf-kicker">General</p><h2 id="general-heading">Organisation settings</h2></div><p>Platform-owned tenant identity and lifecycle.</p></div>
				<p class="pf-admin-id">{ props.OrganisationID }</p>
				if props.CanAdmin {
					<form method="post" action={ templ.SafeURL("/organisations/" + props.OrganisationID + "/admin/general/rename") } class="pf-form-grid">
						<label>Organisation name<input name="name" value={ props.OrganisationName } required maxlength="200" /></label>
						<label>Reason<input name="reason" required maxlength="500" placeholder="Why is this changing?" /></label>
						<input type="hidden" name="csrf" value={ props.CSRF } />
						<button class="pf-button" type="submit">Save name</button>
					</form>
					if props.Role == "owner" || props.SystemAdmin {
						<form method="post" action={ templ.SafeURL("/organisations/" + props.OrganisationID + "/admin/general/archive") } class="pf-danger-form">
							<label>Archive reason<input name="reason" required maxlength="500" placeholder="Why is this organisation closing?" /></label>
							<input type="hidden" name="csrf" value={ props.CSRF } />
							<button class="pf-button pf-button-danger" type="submit">Archive organisation</button>
						</form>
					}
				} else {
					<p class="pf-readonly-note">You can view this Organisation context, but Platform administration actions are limited to Organisation administrators.</p>
				}
			</section>
			<section class="pf-section" aria-labelledby="history-heading">
				<div class="pf-section-heading"><div><p class="pf-kicker">History</p><h2 id="history-heading">Organisation audit</h2></div><p>Recorded Platform facts only.</p></div>
				if !props.CanAdmin {
					<p class="pf-readonly-note">Audit history is visible to Organisation administrators and system administrators.</p>
				} else if len(props.Audit) == 0 {
					@primitives.EmptyState("No audit events", "No Platform audit facts are recorded for this Organisation yet.")
				} else {
					@auditTable(props.Audit)
				}
			</section>
		}
		if props.Section == "members" {
			<section class="pf-section" aria-labelledby="members-heading">
				<div class="pf-section-heading"><div><p class="pf-kicker">Members</p><h2 id="members-heading">Organisation membership</h2></div><p>Product roles are not Platform membership.</p></div>
				if props.CanAdmin {
					<form method="post" action={ templ.SafeURL("/organisations/" + props.OrganisationID + "/admin/members/add") } class="pf-form-grid">
						<label>User ID<input name="user_id" required placeholder="usr_..." /></label>
						<label>Role<select name="role"><option value="member">Member</option><option value="admin">Administrator</option></select></label>
						<label>Reason<input name="reason" required maxlength="500" placeholder="Why is access changing?" /></label>
						<input type="hidden" name="csrf" value={ props.CSRF } />
						<button class="pf-button" type="submit">Add member</button>
					</form>
				}
				@organisationMembers(props)
			</section>
		}
		if props.Section == "workspaces" {
			<section class="pf-section" aria-labelledby="workspaces-heading">
				<div class="pf-section-heading"><div><p class="pf-kicker">Workspaces</p><h2 id="workspaces-heading">Organisation workspaces</h2></div><p>Workspace records remain Platform-owned.</p></div>
				if props.CanAdmin {
					<form method="post" action={ templ.SafeURL("/organisations/" + props.OrganisationID + "/admin/workspaces/create") } class="pf-form-grid">
						<label>Workspace name<input name="name" required maxlength="200" /></label>
						<label>Reason<input name="reason" required maxlength="500" placeholder="Why is this Workspace needed?" /></label>
						<input type="hidden" name="csrf" value={ props.CSRF } />
						<button class="pf-button" type="submit">Create Workspace</button>
					</form>
				} else {
					<p class="pf-readonly-note">You can open Workspaces where you have active access. Creation and lifecycle actions are limited to administrators.</p>
				}
				if len(props.Workspaces) == 0 {
					@primitives.EmptyState("No active Workspaces", "No active Workspace is available to this user in this Organisation.")
				} else {
					<div class="pf-choice-list">
						for _, workspace := range props.Workspaces {
							<a class="pf-choice" href={ templ.SafeURL(workspace.AdminURL) }><span><strong>{ workspace.Name }</strong><small>{ workspace.Status } · { workspace.ID }</small></span><span aria-hidden="true">→</span></a>
						}
					</div>
				}
			</section>
		}
		if props.Section == "products" {
			<section class="pf-section" aria-labelledby="products-heading">
				<div class="pf-section-heading"><div><p class="pf-kicker">Products</p><h2 id="products-heading">Platform access</h2></div><p>Entitlements and assignments do not define product roles.</p></div>
				<form method="post" action={ templ.SafeURL("/organisations/" + props.OrganisationID + "/admin/products/entitlements/add") } class="pf-form-grid">
					<label>Product key<input name="product_key" required placeholder="product.tockrctrl" /></label>
					<label>Reason<input name="reason" required maxlength="500" placeholder="Why is this entitlement needed?" /></label>
					<input type="hidden" name="csrf" value={ props.CSRF } />
					<button class="pf-button" type="submit">Entitle Organisation</button>
				</form>
				<h3 class="pf-subheading">Organisation entitlements</h3>
				if len(props.Entitlements) == 0 {
					@primitives.EmptyState("No entitlements", "This Organisation has no recorded Platform product entitlements.")
				} else {
					<div class="pf-record-list">
						for _, entitlement := range props.Entitlements {
							<div class="pf-record"><span><strong>{ entitlement.ProductKey }</strong><small>{ entitlement.Status }</small></span>
								if entitlement.Active {
									<form method="post" action={ templ.SafeURL("/organisations/" + props.OrganisationID + "/admin/products/entitlements/" + entitlement.ID + "/revoke") }><input type="hidden" name="csrf" value={ props.CSRF } /><input type="hidden" name="reason" value="Revoked from Platform administration" /><button class="pf-text-button" type="submit">Revoke</button></form>
								}
							</div>
						}
					</div>
				}
				<h3 class="pf-subheading">User product assignments</h3>
				<form method="post" action={ templ.SafeURL("/organisations/" + props.OrganisationID + "/admin/products/assignments/add") } class="pf-form-grid">
					<label>User ID<input name="user_id" required placeholder="usr_..." /></label>
					<label>Product key<input name="product_key" required placeholder="product.tockrctrl" /></label>
					<label>Reason<input name="reason" required maxlength="500" placeholder="Why is access assigned?" /></label>
					<input type="hidden" name="csrf" value={ props.CSRF } />
					<button class="pf-button" type="submit">Assign product</button>
				</form>
				if len(props.Assignments) == 0 {
					@primitives.EmptyState("No assignments", "No user product assignments are recorded for this Organisation.")
				} else {
					<div class="pf-record-list">
						for _, assignment := range props.Assignments {
							<div class="pf-record"><span><strong>{ assignment.ProductKey }</strong><small>{ assignment.UserID } · { assignment.Status }</small></span>
								if assignment.Active {
									<form method="post" action={ templ.SafeURL("/organisations/" + props.OrganisationID + "/admin/products/assignments/" + assignment.ID + "/revoke") }><input type="hidden" name="csrf" value={ props.CSRF } /><input type="hidden" name="reason" value="Revoked from Platform administration" /><button class="pf-text-button" type="submit">Revoke</button></form>
								}
							</div>
						}
					</div>
				}
			</section>
		}
	}
}

templ organisationMembers(props OrganisationAdminProps) {
	if len(props.Members) == 0 {
		@primitives.EmptyState("No active members", "No active Organisation membership is available to this view.")
	} else {
		<div class="pf-record-list">
			for _, member := range props.Members {
				<div class="pf-record pf-record-member"><span><strong>{ member.DisplayName }</strong><small>{ member.Email } · { member.UserID } · { member.Role } · assigned { member.AssignedAt }</small></span>
					if props.CanAdmin && member.Role != "owner" {
						<div class="pf-inline-actions"><form method="post" action={ templ.SafeURL("/organisations/" + props.OrganisationID + "/admin/members/" + member.UserID + "/role") }><input type="hidden" name="csrf" value={ props.CSRF } /><input type="hidden" name="role" value={ member.RoleChange } /><input type="hidden" name="reason" value="Updated from Platform administration" /><button class="pf-text-button" type="submit">Change role</button></form><form method="post" action={ templ.SafeURL("/organisations/" + props.OrganisationID + "/admin/members/" + member.UserID + "/remove") }><input type="hidden" name="csrf" value={ props.CSRF } /><input type="hidden" name="reason" value="Removed from Platform administration" /><button class="pf-text-button pf-text-danger" type="submit">Remove</button></form></div>
					}
				</div>
			}
		</div>
	}
}

templ auditTable(events []AdminAudit) {
	<div class="pf-audit-list">
		for _, event := range events {
			<details class="pf-audit-item"><summary><strong>{ event.Event }</strong><span>{ event.OccurredAt }</span></summary><pre>{ event.Details }</pre></details>
		}
	</div>
}

templ WorkspaceAdmin(props WorkspaceAdminProps) {
	@layouts.App("Workspace administration", props.User, props.CSRF, "/organisations") {
		@components.ContextHeader("Workspace administration", props.WorkspaceName, props.OrganisationName)
		<section class="pf-section" aria-labelledby="workspace-admin-heading">
			<div class="pf-section-heading"><div><p class="pf-kicker">Workspace</p><h2 id="workspace-admin-heading">{ props.WorkspaceName }</h2></div><p>{ props.WorkspaceID } · { props.WorkspaceRole }</p></div>
			<div class="pf-action-row"><a class="pf-text-link" href={ templ.SafeURL("/organisations/" + props.OrganisationID + "/admin/workspaces") }>Back to Organisation Workspaces</a><a class="pf-text-link" href={ templ.SafeURL("/?organisation_id=" + props.OrganisationID + "&workspace_id=" + props.WorkspaceID) }>Open launcher</a></div>
		</section>
		if props.Flash != "" {
			<p class="pf-status pf-status-success" role="status">{ props.Flash }</p>
		}
		<section class="pf-section" aria-labelledby="workspace-members-heading">
			<div class="pf-section-heading"><div><p class="pf-kicker">Members</p><h2 id="workspace-members-heading">Workspace access</h2></div><p>Organisation membership remains the parent boundary.</p></div>
			if props.CanAdmin {
				<form method="post" action={ templ.SafeURL("/workspaces/" + props.WorkspaceID + "/admin/members/add") } class="pf-form-grid">
					<label>User ID<input name="user_id" required placeholder="usr_..." /></label>
					<label>Role<select name="role"><option value="viewer">Viewer</option><option value="member">Member</option><option value="admin">Administrator</option></select></label>
					<label>Reason<input name="reason" required maxlength="500" placeholder="Why is Workspace access changing?" /></label>
					<input type="hidden" name="csrf" value={ props.CSRF } />
					<button class="pf-button" type="submit">Add Workspace member</button>
				</form>
				@workspaceMembers(props)
			} else {
				<p class="pf-readonly-note">Workspace members and audit history are visible to Workspace administrators and Organisation administrators.</p>
			}
		</section>
		if props.CanAdmin {
			<section class="pf-section" aria-labelledby="workspace-history-heading">
				<div class="pf-section-heading"><div><p class="pf-kicker">History</p><h2 id="workspace-history-heading">Workspace audit</h2></div><p>Recorded Platform facts only.</p></div>
				if len(props.Audit) == 0 {
					@primitives.EmptyState("No audit events", "No Platform audit facts are recorded for this Workspace yet.")
				} else {
					@auditTable(props.Audit)
				}
			</section>
			<section class="pf-section" aria-labelledby="workspace-lifecycle-heading">
				<div class="pf-section-heading"><div><p class="pf-kicker">Lifecycle</p><h2 id="workspace-lifecycle-heading">Archive Workspace</h2></div><p>Archiving preserves membership history.</p></div>
				<form method="post" action={ templ.SafeURL("/workspaces/" + props.WorkspaceID + "/admin/archive") } class="pf-danger-form"><label>Archive reason<input name="reason" required maxlength="500" /></label><input type="hidden" name="csrf" value={ props.CSRF } /><button class="pf-button pf-button-danger" type="submit">Archive Workspace</button></form>
			</section>
		}
	}
}

templ workspaceMembers(props WorkspaceAdminProps) {
	if len(props.Members) == 0 {
		@primitives.EmptyState("No active Workspace members", "No active Workspace membership is recorded for this Workspace.")
	} else {
		<div class="pf-record-list">
			for _, member := range props.Members {
				<div class="pf-record pf-record-member"><span><strong>{ member.DisplayName }</strong><small>{ member.Email } · { member.UserID } · { member.Role } · assigned { member.AssignedAt }</small></span>
					if props.CanAdmin {
						<div class="pf-inline-actions"><form method="post" action={ templ.SafeURL("/workspaces/" + props.WorkspaceID + "/admin/members/" + member.UserID + "/role") }><input type="hidden" name="csrf" value={ props.CSRF } /><input type="hidden" name="role" value={ member.RoleChange } /><input type="hidden" name="reason" value="Updated from Platform administration" /><button class="pf-text-button" type="submit">Change role</button></form><form method="post" action={ templ.SafeURL("/workspaces/" + props.WorkspaceID + "/admin/members/" + member.UserID + "/remove") }><input type="hidden" name="csrf" value={ props.CSRF } /><input type="hidden" name="reason" value="Removed from Platform administration" /><button class="pf-text-button pf-text-danger" type="submit">Remove</button></form></div>
					}
				</div>
			}
		</div>
	}
}

templ SystemProductAdmin(props SystemProductAdminProps) {
	@layouts.App("System product catalogue", props.User, props.CSRF, "/organisations") {
		@components.ContextHeader("System product catalogue", "Platform", "System administrator")
		<section class="pf-section" aria-labelledby="system-products-heading">
			<div class="pf-section-heading"><div><p class="pf-kicker">System administration</p><h2 id="system-products-heading">Product catalogue</h2></div><p>Catalogue lifecycle is Platform-owned; product roles remain external.</p></div>
			if props.Flash != "" {
				<p class="pf-status pf-status-success" role="status">{ props.Flash }</p>
			}
			if len(props.Products) == 0 {
				@primitives.EmptyState("No products", "No Platform products are recorded in the catalogue.")
			} else {
				<div class="pf-record-list">
					for _, product := range props.Products {
						<div class="pf-record"><span><strong>{ product.DisplayName }</strong><small>{ product.Key } · { product.Status }</small></span>
							if product.Active {
								<form method="post" action={ templ.SafeURL("/admin/system/products/" + product.Key + "/retire") }><input type="hidden" name="csrf" value={ props.CSRF } /><input type="hidden" name="reason" value="Retired from Platform system administration" /><button class="pf-text-button pf-text-danger" type="submit">Retire</button></form>
							}
						</div>
					}
				</div>
			}
		</section>
	}
}
